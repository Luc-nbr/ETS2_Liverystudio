{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ETS2 Livery Studio",
  "version": "0.1.0",
  "identifier": "nl.liverystudio.ets2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ETS2 Livery Studio",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "GraphicsAndDesign",
    "shortDescription": "3D livery editor for Euro Truck Simulator 2",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
